# Required for production compose
ATT_SECRET_KEY=replace-with-long-random-string
ATT_SITE_ADDRESS=localhost
ATT_CORS_ORIGINS=https://localhost
ATT_BOOTSTRAP_ADMIN_EMAIL=admin@localhost
ATT_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
ATT_ACME_EMAIL=

# Public anonymous demo (see DEPLOY.md)
ATT_DEMO_MODE=true
ATT_REQUIRE_AUTH=false
ATT_MAX_UPLOAD_MB=25
ATT_DEFAULT_ISOLATE_QUALITY=fast
ATT_ALLOW_YOUTUBE=false

# Optional overrides
ATT_S3_ACCESS_KEY=minioadmin
ATT_S3_SECRET_KEY=minioadmin

# Lite / Oracle Always Free: see .env.lite.example and docker-compose.lite.yml
